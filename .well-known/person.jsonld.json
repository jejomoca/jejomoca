      "worksFor": [
        {
          "@type": "OrganizationRole",
          "roleName": "Data Analyst / Operational Planning Officer",
          "startDate": "2025-01",
          "endDate": "2026-08",
          "description": "Operational and geospatial analytics for service planning: routes, fleets, frequencies, calendars and network maps, reporting to the Operations Directorate. Built the province-wide service-change ETL pipeline in Python, with automated email intake, transformation into the corporate data model, database loading and automatic input–output reconciliation, cutting cycle time from nine days to three. Automated route generation in QGIS from stop data and the OSRM routing API, from six days to two. Built route-adherence analytics comparing vehicle geolocation against published GTFS traces: broken-trip detection, percentage similarity to the reference route, unplanned diversions and delays. Built and maintained nine Tableau dashboards with automated publishing, and produced analytical presentations in Marimo with live scraping and interactive KPI controls.",
          "worksFor": {
